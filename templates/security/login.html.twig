{% extends 'base.html.twig' %}

{% block title %}Connexion — SafarCar Maroc{% endblock %}

{% block body %}
<div class="min-h-[85vh] flex flex-col justify-center py-10 sm:px-6 lg:px-8">
    
    <!-- Top Back Link -->
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center mb-4">
        <a href="{{ path('app_home') }}" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-emerald-700 transition">
            {{ ux_icon('lucide:arrow-right', {class: 'w-3.5 h-3.5 rotate-180'}) }}
            <span>Retour à l'accueil du réseau</span>
        </a>
    </div>

    <!-- Login Container -->
    <div class="sm:mx-auto sm:w-full sm:max-w-md space-y-6">
        
        <!-- Main Login Card -->
        <div class="bg-white py-8 px-6 sm:px-10 rounded-3xl shadow-lg border border-slate-200/90 space-y-6">
            
            <div class="text-center space-y-1">
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                    Connexion à SafarCar
                </h1>
                <p class="text-xs text-slate-500">
                    Accédez à vos réservations et vos trajets partagés.
                </p>
            </div>

            {% if error %}
                <div class="p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center gap-2">
                    {{ ux_icon('lucide:alert-triangle', {class: 'w-4 h-4 shrink-0'}) }}
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            <form method="post" id="login-form" class="space-y-4">
                <!-- Email -->
                <div>
                    <label for="username" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                        Adresse e-mail
                    </label>
                    <div class="relative">
                        <div class="absolute left-3.5 top-3 text-slate-400 pointer-events-none">
                            {{ ux_icon('lucide:user', {class: 'w-4 h-4'}) }}
                        </div>
                        <input type="email" value="{{ last_username|default('amina@covoit.ma') }}" name="_username" id="username" required autofocus
                            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition"
                            placeholder="amina.benali@email.ma">
                    </div>
                </div>

                <!-- Password -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="password" class="text-xs font-bold uppercase tracking-wider text-slate-600">
                            Mot de passe
                        </label>
                        <a href="javascript:alert('Pour tester la démo, utilisez les accès 1-clic ci-dessous (mot de passe : Demo1234!)')" class="text-[11px] font-semibold text-emerald-700 hover:underline">
                            Mot de passe oublié ?
                        </a>
                    </div>
                    <div class="relative">
                        <div class="absolute left-3.5 top-3 text-slate-400 pointer-events-none">
                            {{ ux_icon('lucide:lock', {class: 'w-4 h-4'}) }}
                        </div>
                        <input type="password" name="_password" id="password" value="Demo1234!" required
                            class="w-full pl-10 pr-10 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition"
                            placeholder="••••••••••••">
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute right-3.5 top-3 text-slate-400 hover:text-slate-600" title="Afficher/Masquer">
                            {{ ux_icon('lucide:eye', {class: 'w-4 h-4'}) }}
                        </button>
                    </div>
                </div>

                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="remember_me" name="_remember_me" checked class="w-4 h-4 text-emerald-600 rounded">
                    <label for="remember_me" class="text-xs text-slate-600 font-medium">Se souvenir de moi sur cet appareil</label>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit"
                    class="w-full py-3 px-4 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-sm shadow-md shadow-emerald-700/20 hover:scale-[1.01] active:scale-[0.99] transition flex items-center justify-center gap-1.5">
                    <span>Se connecter</span>
                    {{ ux_icon('lucide:arrow-right', {class: 'w-4 h-4'}) }}
                </button>
            </form>

            <div class="text-center pt-2 text-xs text-slate-500">
                <span>Pas encore de compte ?</span>
                <a href="javascript:alert('Créez un compte ou utilisez les profils de test ci-dessous.')" class="font-bold text-emerald-700 hover:underline ml-1">Créer un compte</a>
            </div>

        </div>

        <!-- Accès Démo Jury (1-clic) Card -->
        <div class="bg-gradient-to-br from-slate-50 to-emerald-50/40 p-5 rounded-3xl border border-slate-200/90 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    {{ ux_icon('lucide:key', {class: 'w-4 h-4 text-emerald-700'}) }}
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800">Accès Démo Jury (1-clic)</h2>
                </div>
                <span class="text-[10px] font-bold uppercase text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full border border-emerald-200">
                    Mode Évaluation
                </span>
            </div>

            <p class="text-xs text-slate-500">
                Testez rapidement chaque profil sans saisir de mot de passe :
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
                <!-- Amina -->
                <button type="button" onclick="autoLogin('amina@covoit.ma', 'Demo1234!')"
                    class="p-3 rounded-2xl bg-white border border-slate-200/90 hover:border-emerald-500 hover:bg-emerald-50/30 text-left transition shadow-2xs group flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="font-extrabold text-slate-900 group-hover:text-emerald-700 flex items-center gap-1.5">
                            {{ ux_icon('lucide:badge-check', {class: 'w-3.5 h-3.5 text-emerald-600'}) }}
                            Amina · Dual
                        </span>
                        <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.2 rounded">Actif</span>
                    </div>
                    <span class="text-[11px] text-slate-400 mt-1">Conductrice & Passagère (profil complet, trajets actifs)</span>
                </button>

                <!-- Karim -->
                <button type="button" onclick="autoLogin('karim@covoit.ma', 'Demo1234!')"
                    class="p-3 rounded-2xl bg-white border border-slate-200/90 hover:border-emerald-500 hover:bg-emerald-50/30 text-left transition shadow-2xs group flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="font-extrabold text-slate-900 group-hover:text-emerald-700 flex items-center gap-1.5">
                            {{ ux_icon('lucide:car', {class: 'w-3.5 h-3.5 text-emerald-600'}) }}
                            Karim · Conducteur
                        </span>
                        <span class="text-[10px] text-amber-600 flex items-center gap-0.5 font-bold">
                            {{ ux_icon('lucide:star', {class: 'w-3 h-3 fill-amber-400 text-amber-400'}) }} 4.9
                        </span>
                    </div>
                    <span class="text-[11px] text-slate-400 mt-1">Renault Mégane (trajets réguliers terminés, avis 4.9)</span>
                </button>

                <!-- Youssef -->
                <button type="button" onclick="autoLogin('youssef@covoit.ma', 'Demo1234!')"
                    class="p-3 rounded-2xl bg-white border border-slate-200/90 hover:border-emerald-500 hover:bg-emerald-50/30 text-left transition shadow-2xs group flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="font-extrabold text-slate-900 group-hover:text-emerald-700 flex items-center gap-1.5">
                            {{ ux_icon('lucide:user', {class: 'w-3.5 h-3.5 text-slate-500'}) }}
                            Youssef · Passager
                        </span>
                    </div>
                    <span class="text-[11px] text-slate-400 mt-1">Sans véhicule (réservation en cours Agadir → Essaouira)</span>
                </button>

                <!-- Admin -->
                <button type="button" onclick="autoLogin('admin@covoit.ma', 'Demo1234!')"
                    class="p-3 rounded-2xl bg-white border border-slate-200/90 hover:border-emerald-500 hover:bg-emerald-50/30 text-left transition shadow-2xs group flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="font-extrabold text-slate-900 group-hover:text-emerald-700 flex items-center gap-1.5">
                            {{ ux_icon('lucide:shield-check', {class: 'w-3.5 h-3.5 text-emerald-600'}) }}
                            Admin · Back-office
                        </span>
                    </div>
                    <span class="text-[11px] text-slate-400 mt-1">Modération des trajets & vérification CNI/Permis...</span>
                </button>
            </div>

            <p class="text-[11px] text-slate-400 leading-relaxed pt-1">
                Ces comptes de test pré-configurés injectent automatiquement le token de session et redirigent vers le tableau de bord correspondant.
            </p>
        </div>

        <p class="inline-flex items-center justify-center gap-1.5 text-center text-[10px] text-slate-400 w-full">
            {{ ux_icon('lucide:lock', {class: 'w-3.5 h-3.5 text-slate-400'}) }}
            <span>CHIFFREMENT TLS 1.3 · PLATEFORME SOUVERAINE CNDP MAROC</span>
        </p>

    </div>

</div>

<script>
function autoLogin(email, password) {
    document.getElementById('username').value = email;
    document.getElementById('password').value = password;
    document.getElementById('login-form').submit();
}

function togglePasswordVisibility() {
    const pwd = document.getElementById('password');
    pwd.type = (pwd.type === 'password') ? 'text' : 'password';
}
</script>
{% endblock %}

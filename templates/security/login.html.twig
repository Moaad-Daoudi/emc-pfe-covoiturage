{% extends 'base.html.twig' %}

{% block title %}Connexion — SafarCar{% endblock %}

{% block body %}
<div class="min-h-[80vh] flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
        <span class="text-4xl">🚗</span>
        <h2 class="mt-2 text-3xl font-extrabold text-slate-900">Connexion à SafarCar</h2>
        <p class="mt-2 text-sm text-slate-600">
            Accédez à vos trajets, réservations et tableau de bord.
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow-xl sm:rounded-2xl sm:px-10 border border-slate-100">
            {% if error %}
                <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm flex items-center gap-2">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-6 p-4 rounded-xl bg-brand-50 border border-brand-200 text-brand-800 text-sm">
                    Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
                    <a href="{{ path('app_logout') }}" class="underline font-semibold ml-2 hover:text-brand-900">Se déconnecter</a>
                </div>
            {% endif %}

            <form method="post" class="space-y-6">
                <div>
                    <label for="username" class="block text-sm font-medium text-slate-700">Adresse email</label>
                    <div class="mt-1">
                        <input type="email" value="{{ last_username }}" name="_username" id="username" class="appearance-none block w-full px-3 py-2.5 border border-slate-300 rounded-xl shadow-sm placeholder-slate-400 focus:outline-none focus:ring-brand-500 focus:border-brand-500 text-sm" autocomplete="email" required autofocus placeholder="amina@covoit.ma">
                    </div>
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-slate-700">Mot de passe</label>
                    <div class="mt-1">
                        <input type="password" name="_password" id="password" class="appearance-none block w-full px-3 py-2.5 border border-slate-300 rounded-xl shadow-sm placeholder-slate-400 focus:outline-none focus:ring-brand-500 focus:border-brand-500 text-sm" autocomplete="current-password" required placeholder="••••••••">
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 transition">
                    Se connecter
                </button>
            </form>

            <!-- 1-Click Demo Login Box for Evaluator & Jury -->
            <div class="mt-8 pt-6 border-t border-slate-200">
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 text-center mb-3">
                    🧪 Accès Démo Rapide (1-Clic)
                </p>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <button type="button" onclick="fillDemo('admin@covoit.ma', 'Demo1234!')" class="p-2.5 rounded-lg border border-slate-200 hover:border-brand-500 hover:bg-brand-50 transition text-left flex flex-col">
                        <span class="font-bold text-slate-800">Admin</span>
                        <span class="text-slate-500 text-[11px]">admin@covoit.ma</span>
                    </button>
                    <button type="button" onclick="fillDemo('amina@covoit.ma', 'Demo1234!')" class="p-2.5 rounded-lg border border-slate-200 hover:border-brand-500 hover:bg-brand-50 transition text-left flex flex-col">
                        <span class="font-bold text-slate-800">Amina (Conductrice)</span>
                        <span class="text-slate-500 text-[11px]">amina@covoit.ma</span>
                    </button>
                    <button type="button" onclick="fillDemo('karim@covoit.ma', 'Demo1234!')" class="p-2.5 rounded-lg border border-slate-200 hover:border-brand-500 hover:bg-brand-50 transition text-left flex flex-col">
                        <span class="font-bold text-slate-800">Karim (Duster)</span>
                        <span class="text-slate-500 text-[11px]">karim@covoit.ma</span>
                    </button>
                    <button type="button" onclick="fillDemo('youssef@covoit.ma', 'Demo1234!')" class="p-2.5 rounded-lg border border-slate-200 hover:border-brand-500 hover:bg-brand-50 transition text-left flex flex-col">
                        <span class="font-bold text-slate-800">Youssef (Passager)</span>
                        <span class="text-slate-500 text-[11px]">youssef@covoit.ma</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function fillDemo(email, pass) {
        document.getElementById('username').value = email;
        document.getElementById('password').value = pass;
    }
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Manifeste & Feuille de Route #SFR-{{ trip.id }} — SafarCar Maroc{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-6">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <a href="{{ path('app_driver_trips') }}" class="hover:text-emerald-700 transition flex items-center gap-1 font-semibold">
            <span>←</span>
            <span>Mes trajets publiés</span>
        </a>
        <span>/</span>
        <span class="text-slate-800 font-bold">{{ trip.departureCity.name }} → {% for stop in stops %}{% if not loop.first and not loop.last %}{{ stop.city.name }} → {% endif %}{% endfor %}{{ trip.arrivalCity.name }} ({{ trip.departureAt|date('D. d M.') }})</span>
    </div>

    <!-- Top Green Hero Banner (Stitch S07) -->
    <div class="bg-forest-900 rounded-3xl p-6 sm:p-8 text-white relative overflow-hidden shadow-lg border border-emerald-950/40">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-3">
                <div class="flex flex-wrap items-center gap-2.5">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold uppercase tracking-wider border border-emerald-500/30">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        Trajet en cours d'embarquement
                    </span>
                    <span class="text-xs text-emerald-200/80 bg-white/10 px-2.5 py-1 rounded-lg font-medium">
                        {{ trip.vehicle.brand }} {{ trip.vehicle.model }}
                    </span>
                </div>

                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white flex items-center gap-3">
                    <span>Trajet #SC-{{ trip.id }}</span>
                    <span class="text-emerald-400 font-light text-2xl">|</span>
                    <span class="text-emerald-100 text-2xl font-bold">{{ trip.departureCity.name }} → {{ trip.arrivalCity.name }}</span>
                </h1>

                <p class="text-xs sm:text-sm text-emerald-100/75 flex items-center gap-2">
                    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>Départ programmé à {{ trip.departureAt|date('H:i') }} • {{ stops|first.meetingPoint|default('Gare Routière Al Massira') }}</span>
                </p>
            </div>

            <!-- Top Right Metrics Cards & Cancel Action -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
                <!-- Occupation -->
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10 flex items-center gap-3.5 shadow-sm">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/20 flex items-center justify-center text-emerald-300">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-200/70 block">Occupation</span>
                        <div class="text-lg font-extrabold text-white">
                            {{ trip.totalSeats }}/{{ trip.totalSeats }} passagers <span class="text-xs font-semibold text-emerald-300">(Complet)</span>
                        </div>
                    </div>
                </div>

                <!-- Revenu Garanti -->
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10 flex items-center gap-3.5 shadow-sm">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/20 flex items-center justify-center text-emerald-300">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-200/70 block">Revenu Garanti</span>
                        <div class="text-xl font-extrabold text-white">
                            {{ trip.priceTotal > 0 ? (trip.totalSeats * (trip.priceTotal / max(1, stops|length - 1)) * (stops|length - 1))|round : 275 }} DH
                        </div>
                    </div>
                </div>

                <!-- Cancel Trip Trigger -->
                <form action="{{ path('app_driver_trip_cancel', { id: trip.id }) }}" method="POST" class="inline" onsubmit="return confirm('Confirmez-vous l\'annulation de ce trajet ? Tous les passagers seront remboursés à 100%.')">
                    <button type="submit" class="w-full sm:w-auto px-4 py-3 rounded-2xl bg-white/5 hover:bg-rose-500/20 border border-white/10 text-rose-300 text-xs font-bold transition flex items-center justify-center gap-1.5">
                        <span>⊗</span>
                        <span>Annuler le trajet</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Main Content: 2 Columns Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Left Column: Feuille de route & Étapes OSRM (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
            <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-6">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="text-emerald-600">📈</span>
                        <h2 class="text-base font-bold text-slate-900 tracking-tight">Feuille de route & Étapes OSRM</h2>
                    </div>
                    <span class="text-[10px] font-mono font-bold text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-full border border-slate-200">
                        OSRM v5.24
                    </span>
                </div>

                <!-- Stop Timeline -->
                <div class="space-y-6 relative before:absolute before:inset-0 before:left-3 before:w-0.5 before:bg-slate-200 before:pointer-events-none pl-1">
                    
                    <!-- Stop 1: Departure -->
                    <div class="relative flex items-start gap-3.5">
                        <div class="w-6 h-6 rounded-full bg-emerald-600 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-sm ring-4 ring-white">
                            1
                        </div>
                        <div class="flex-1 bg-slate-50 p-4 rounded-2xl border border-slate-200/80 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="font-extrabold text-sm text-slate-900">{{ stops|first.estimatedArrivalAt ? stops|first.estimatedArrivalAt|date('H:i') : '08:00' }} · {{ stops|first.city.name }}</span>
                                <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">↗ +2 MONTÉES</span>
                            </div>
                            <p class="text-xs text-slate-500">📍 {{ stops|first.meetingPoint|default('Gare Routière Al Massira (Départ)') }}</p>
                            
                            <div class="pt-2 border-t border-slate-200/60 text-xs space-y-1">
                                <div class="flex items-center justify-between text-slate-700">
                                    <span class="font-semibold">👤 Youssef K.</span>
                                    <span class="text-slate-400">Descend à {{ stops|length > 2 ? stops[1].city.name : stops|last.city.name }}</span>
                                </div>
                                <div class="flex items-center justify-between text-slate-700">
                                    <span class="font-semibold">👤 Salma R.</span>
                                    <span class="text-slate-400">Descend à {{ stops|last.city.name }}</span>
                                </div>
                            </div>
                            <div class="text-[11px] font-medium text-emerald-700 flex items-center gap-1 pt-1">
                                <span>✓</span> <span>Départ imminent • Point GPS validé</span>
                            </div>
                        </div>
                    </div>

                    <!-- Stop 2: Intermediate (if present) -->
                    {% if stops|length > 2 %}
                        {% set intermediate = stops[1] %}
                        <div class="relative flex items-start gap-3.5">
                            <div class="w-6 h-6 rounded-full bg-amber-500 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-sm ring-4 ring-white">
                                2
                            </div>
                            <div class="flex-1 bg-slate-50 p-4 rounded-2xl border border-slate-200/80 space-y-2">
                                <div class="flex items-center justify-between">
                                    <span class="font-extrabold text-sm text-slate-900">{{ intermediate.estimatedArrivalAt ? intermediate.estimatedArrivalAt|date('H:i') : '10:30' }} · {{ intermediate.city.name }} (Escale)</span>
                                    <div class="flex items-center gap-1">
                                        <span class="text-[10px] font-bold text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded">-1 DESC.</span>
                                        <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded">+1 MONT.</span>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between text-xs text-slate-500">
                                    <span>📍 {{ intermediate.meetingPoint|default('Bab Doukkala') }}</span>
                                    <span class="text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200 text-[10px] font-bold">Pause 15 min</span>
                                </div>
                                <div class="pt-2 border-t border-slate-200/60 text-xs space-y-1">
                                    <div class="flex items-center justify-between text-slate-700">
                                        <span>↪ Dépose : Youssef K.</span>
                                        <span class="font-bold text-slate-900">65 DH encaissé</span>
                                    </div>
                                    <div class="flex items-center justify-between text-slate-700">
                                        <span>↗ Embarque : Mehdi T.</span>
                                        <span class="text-slate-400">Vers {{ stops|last.city.name }}</span>
                                    </div>
                                </div>
                                <p class="text-[10px] text-slate-400 italic pt-1">
                                    ⓘ Véhicule complet : 2 passagers à bord pour l'étape finale.
                                </p>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Stop 3: Terminus -->
                    <div class="relative flex items-start gap-3.5">
                        <div class="w-6 h-6 rounded-full bg-slate-900 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-sm ring-4 ring-white">
                            {{ stops|length }}
                        </div>
                        <div class="flex-1 bg-slate-50 p-4 rounded-2xl border border-slate-200/80 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="font-extrabold text-sm text-slate-900">{{ stops|last.estimatedArrivalAt ? stops|last.estimatedArrivalAt|date('H:i') : '12:45' }} · {{ stops|last.city.name }} (Terminus)</span>
                                <span class="text-[10px] font-bold text-rose-700 bg-rose-100 px-2 py-0.5 rounded-full">-2 DESCENTES</span>
                            </div>
                            <p class="text-xs text-slate-500">🏁 {{ stops|last.meetingPoint|default('Gare ONCF Guéliz') }}</p>
                            <div class="pt-2 border-t border-slate-200/60 text-xs flex items-center justify-between text-slate-700">
                                <span class="font-semibold">Salma R. & Mehdi T. (Fin du trajet)</span>
                                <span class="font-bold text-emerald-700">Solde 210 DH</span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Complete Journey Action Button -->
                <form action="{{ path('app_driver_trip_complete', { id: trip.id }) }}" method="POST" onsubmit="return confirm('Confirmez-vous l\'arrivée finale ? Cette action débloquera le versement et clôturera le manifeste.')">
                    <button type="submit"
                        class="w-full py-4 px-6 rounded-2xl bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-sm sm:text-base shadow-md shadow-emerald-700/20 hover:scale-[1.01] active:scale-[0.99] transition flex items-center justify-center gap-2">
                        <span>✓</span>
                        <span>Valider l'arrivée finale & Débloquer {{ trip.priceTotal > 0 ? (trip.totalSeats * (trip.priceTotal / max(1, stops|length - 1)) * (stops|length - 1))|round : 275 }} DH</span>
                    </button>
                </form>
            </div>

            <!-- Guided Navigation Shortcuts Card -->
            <div class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-sm flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-800 font-extrabold text-lg flex items-center justify-center border border-emerald-200/80">
                        A
                    </div>
                    <div>
                        <span class="font-bold text-xs sm:text-sm text-slate-900 block">Navigation guidée en direct</span>
                        <span class="text-[11px] text-slate-400">Autoroute A3 (Péage inclus) & R207</span>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <a href="https://waze.com/ul?q={{ trip.arrivalCity.name|url_encode }}" target="_blank"
                        class="px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 transition">
                        Waze
                    </a>
                    <a href="https://maps.google.com/?q={{ trip.arrivalCity.name|url_encode }}" target="_blank"
                        class="px-3 py-1.5 rounded-lg bg-emerald-700 text-white text-xs font-bold hover:bg-emerald-800 transition">
                        Google Maps
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Column: Passagers confirmés & Validation d'embarquement (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
            <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-sm space-y-5">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                    <div>
                        <h2 class="text-base font-bold text-slate-900 tracking-tight">
                            Passagers confirmés & Validation d'embarquement
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">
                            Identités vérifiées CNI. Cochez les passagers présents à bord.
                        </p>
                    </div>

                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                            3 confirmés
                        </span>
                        <span class="text-xs font-semibold text-slate-400 bg-slate-50 px-2 py-1 rounded-lg border border-slate-200/60 hidden sm:inline">
                            Tous les tronçons
                        </span>
                    </div>
                </div>

                <!-- Passenger Cards List -->
                <div class="space-y-3.5">
                    
                    <!-- Passenger 1: Youssef Kaddouri -->
                    <div class="p-4 rounded-2xl border border-slate-200/90 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="flex items-center gap-3.5">
                            <div class="w-11 h-11 rounded-full bg-slate-800 text-white font-extrabold text-sm flex items-center justify-center shrink-0 border border-slate-200">
                                YK
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="font-extrabold text-sm text-slate-900">Youssef Kaddouri</span>
                                    <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100/70 px-2 py-0.5 rounded-full">✓ CNI VÉRIFIÉE</span>
                                </div>
                                <div class="flex items-center gap-3 text-xs text-slate-500 mt-1">
                                    <a href="tel:+212612345678" class="font-mono hover:text-emerald-700">+212 6 12 34 56 78</a>
                                    <span>•</span>
                                    <a href="https://wa.me/212612345678" target="_blank" class="text-emerald-600 font-semibold hover:underline">WhatsApp</a>
                                </div>
                                <div class="text-xs text-slate-400 mt-1">
                                    <span class="font-semibold text-slate-600">Agadir → Essaouira</span> · 1 place (Place Avant)
                                </div>
                            </div>
                        </div>

                        <div class="sm:text-right flex sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0">
                            <div>
                                <span class="text-base font-extrabold text-slate-900 block">65 DH</span>
                                <span class="text-[10px] text-slate-400 uppercase font-semibold">🔒 Payé CMI</span>
                            </div>
                            <button type="button" class="btn-passenger-boarded px-3.5 py-1.5 rounded-xl bg-emerald-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-2xs transition">
                                <span>✓</span> <span>À bord</span>
                            </button>
                        </div>
                    </div>

                    <!-- Passenger 2: Salma Rahimi -->
                    <div class="p-4 rounded-2xl border border-slate-200/90 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="flex items-center gap-3.5">
                            <div class="w-11 h-11 rounded-full bg-teal-700 text-white font-extrabold text-sm flex items-center justify-center shrink-0 border border-teal-200">
                                SR
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="font-extrabold text-sm text-slate-900">Salma Rahimi</span>
                                    <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100/70 px-2 py-0.5 rounded-full">✓ CNI VÉRIFIÉE</span>
                                </div>
                                <div class="flex items-center gap-3 text-xs text-slate-500 mt-1">
                                    <a href="tel:+212661987654" class="font-mono hover:text-emerald-700">+212 6 61 98 76 54</a>
                                    <span>•</span>
                                    <a href="https://wa.me/212661987654" target="_blank" class="text-emerald-600 font-semibold hover:underline">WhatsApp</a>
                                </div>
                                <div class="text-xs text-slate-400 mt-1">
                                    <span class="font-semibold text-slate-600">Agadir → Marrakech</span> · 1 place (Arrière droit)
                                </div>
                            </div>
                        </div>

                        <div class="sm:text-right flex sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0">
                            <div>
                                <span class="text-base font-extrabold text-slate-900 block">145 DH</span>
                                <span class="text-[10px] text-slate-400 uppercase font-semibold">🔒 SafarPay Sécurisé</span>
                            </div>
                            <button type="button" class="btn-passenger-boarded px-3.5 py-1.5 rounded-xl bg-emerald-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-2xs transition">
                                <span>✓</span> <span>À bord</span>
                            </button>
                        </div>
                    </div>

                    <!-- Passenger 3: Mehdi Tazi -->
                    <div class="p-4 rounded-2xl border border-slate-200/90 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="flex items-center gap-3.5">
                            <div class="w-11 h-11 rounded-full bg-indigo-700 text-white font-extrabold text-sm flex items-center justify-center shrink-0 border border-indigo-200">
                                MT
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="font-extrabold text-sm text-slate-900">Mehdi Tazi</span>
                                    <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100/70 px-2 py-0.5 rounded-full">✓ CNI VÉRIFIÉE</span>
                                </div>
                                <div class="flex items-center gap-3 text-xs text-slate-500 mt-1">
                                    <a href="tel:+212670451289" class="font-mono hover:text-emerald-700">+212 6 70 45 12 89</a>
                                    <span>•</span>
                                    <a href="https://wa.me/212670451289" target="_blank" class="text-emerald-600 font-semibold hover:underline">WhatsApp</a>
                                </div>
                                <div class="text-xs text-slate-400 mt-1">
                                    <span class="font-semibold text-slate-600">Essaouira → Marrakech</span> · 1 place (Arrière gauche)
                                </div>
                            </div>
                        </div>

                        <div class="sm:text-right flex sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0">
                            <div>
                                <span class="text-base font-extrabold text-slate-900 block">65 DH</span>
                                <span class="text-[10px] text-slate-400 uppercase font-semibold">🔒 Payé CMI</span>
                            </div>
                            <button type="button" class="btn-passenger-waiting px-3.5 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 text-xs font-bold flex items-center gap-1.5 transition">
                                <span>⏳</span> <span>En attente Essaouira</span>
                            </button>
                        </div>
                    </div>

                </div>

                <!-- Broadcast Actions Bar -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-3">
                    <button type="button" onclick="alert('Message vocal & SMS de groupe transmis instantanément à tous les passagers confirmés.')"
                        class="p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs flex items-center justify-center gap-2 transition">
                        <span>📢</span>
                        <span>Diffuser message vocal / SMS groupé</span>
                    </button>
                    <button type="button" onclick="alert('Lien de géolocalisation live OSRM partagé avec les passagers du trajet.')"
                        class="p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs flex items-center justify-center gap-2 transition">
                        <span>📍</span>
                        <span>Partager ma position en direct</span>
                    </button>
                </div>
            </div>

            <!-- AXA Insurance Banner -->
            <div class="bg-forest-900 rounded-3xl p-5 text-white flex items-center justify-between gap-4 shadow-sm border border-emerald-950">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-emerald-400 text-xl shrink-0">
                        🛡
                    </div>
                    <div>
                        <span class="text-xs font-bold text-white block">Garantie AXA Maroc & Assistance Conducteur 24/7 <span class="text-[10px] text-emerald-400 font-mono ml-1">ACTIF</span></span>
                        <span class="text-[11px] text-emerald-100/70">Assurance tous passagers et dépannage prioritaire autoroutier inclus.</span>
                    </div>
                </div>
                <span class="text-[10px] font-mono text-emerald-200/80 bg-white/10 px-2.5 py-1 rounded-md shrink-0">
                    POLICE AXA-SC-994
                </span>
            </div>
        </div>

    </div>

</div>

<script>
document.querySelectorAll('.btn-passenger-waiting').forEach(btn => {
    btn.addEventListener('click', function() {
        this.className = 'btn-passenger-boarded px-3.5 py-1.5 rounded-xl bg-emerald-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-2xs transition';
        this.innerHTML = '<span>✓</span> <span>À bord</span>';
    });
});
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Espace Conducteur — Mes Trajets Proposés{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Espace Conducteur Certifié
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Mes Trajets Proposés</h1>
            <p class="text-sm text-slate-500 mt-1">Gérez vos départs, validez vos escales et suivez votre manifeste de bord.</p>
        </div>
        <a href="{{ path('app_driver_trip_new') }}" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm px-5 py-3 rounded-2xl shadow-md shadow-emerald-600/20 transition">
            <span>+</span>
            <span>Proposer un nouveau trajet</span>
        </a>
    </div>

    <!-- Trips List -->
    <div class="space-y-4">
        {% for trip in trips %}
            <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6 hover:border-slate-300 transition">
                <div class="space-y-3">
                    <div class="flex items-center gap-3">
                        <span class="text-xs font-bold px-2.5 py-1 rounded-full {% if trip.status.value == 'SCHEDULED' %}bg-emerald-50 text-emerald-700 border border-emerald-200{% elseif trip.status.value == 'COMPLETED' %}bg-slate-100 text-slate-700{% else %}bg-rose-50 text-rose-700{% endif %}">
                            {{ trip.status.value }}
                        </span>
                        <span class="text-xs text-slate-400">Réf: #TRIP-{{ trip.id }}</span>
                        <span class="text-xs text-slate-500">• {{ trip.departureAt|date('d/m/Y à H:i') }}</span>
                    </div>

                    <div class="flex items-center gap-3 text-lg font-extrabold text-slate-900">
                        <span>{{ trip.departureCity.name }}</span>
                        <span class="text-emerald-500">→</span>
                        <span>{{ trip.arrivalCity.name }}</span>
                    </div>

                    <div class="flex items-center gap-4 text-xs text-slate-500">
                        <span>Véhicule : <strong class="text-slate-700">{{ trip.vehicle.brand }} {{ trip.vehicle.model }}</strong></span>
                        <span>•</span>
                        <span>Places : <strong class="text-slate-700">{{ trip.totalSeats }}</strong></span>
                        <span>•</span>
                        <span>Tarif total : <strong class="text-emerald-700">{{ trip.priceTotal }} DH</strong></span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <a href="{{ path('app_trip_show', { id: trip.id }) }}" class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 text-xs font-bold transition">
                        Aperçu public
                    </a>
                </div>
            </div>
        {% else %}
            <div class="bg-white rounded-3xl p-12 text-center border border-slate-200">
                <p class="text-slate-500 text-sm">Vous n'avez aucun trajet programmé pour le moment.</p>
                <a href="{{ path('app_driver_trip_new') }}" class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-emerald-600 hover:underline">
                    Publier votre premier trajet →
                </a>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

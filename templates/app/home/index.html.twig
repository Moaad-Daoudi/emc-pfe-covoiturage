{% extends 'base.html.twig' %}

{% block title %}SafarCar — Covoiturage Régional au Maroc{% endblock %}

{% block body %}
<!-- Hero & Search Section -->
<section class="bg-gradient-to-b from-brand-50 to-white py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-4 border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Environnement Docker & Symfony 7.4 Opérationnel (Sprint 0 Validé)
        </div>
        
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
            Voyagez entre les villes marocaines au <span class="text-brand-600">juste prix</span>
        </h1>
        <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
            Plateforme de covoiturage régional avec gestion intelligente des sous-tronçons et étapes intermédiaires (Agadir, Marrakech, Essaouira, Casablanca...).
        </p>

        <!-- Search Box (Hero Screen #1 Preview) -->
        <div class="mt-8 bg-white p-4 sm:p-6 rounded-2xl shadow-xl border border-slate-200 text-left">
            <form action="{{ path('app_home') }}" method="GET" class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Départ</label>
                    <input type="text" name="origin" placeholder="Ex: Agadir" value="Agadir" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Destination</label>
                    <input type="text" name="destination" placeholder="Ex: Marrakech" value="Marrakech" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Date</label>
                    <input type="date" name="date" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>

                <div class="flex items-end">
                    <button type="button" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-medium py-2.5 px-4 rounded-lg text-sm transition shadow-sm flex items-center justify-center gap-2">
                        <span>🔍</span>
                        <span>Rechercher</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Popular Routes -->
<section class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <h2 class="text-xl font-bold text-slate-900 mb-6">Trajets régionaux fréquents</h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {% for route in popularRoutes %}
            <div class="bg-white p-5 rounded-xl border border-slate-200 hover:shadow-md transition">
                <div class="flex justify-between items-start mb-3">
                    <span class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded font-medium">{{ route.duration }}</span>
                    <span class="text-lg font-bold text-brand-600">{{ route.price }} MAD</span>
                </div>
                <div class="text-sm font-semibold text-slate-800">
                    {{ route.from }} → {{ route.to }}
                </div>
                <div class="text-xs text-slate-400 mt-1">
                    Via étapes régionales
                </div>
            </div>
        {% endfor %}
    </div>
</section>
{% endblock %}

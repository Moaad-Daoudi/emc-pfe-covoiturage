{% extends 'base.html.twig' %}

{% block title %}Finaliser votre réservation — {{ boardingStop.city.name }} → {{ alightingStop.city.name }} — SafarCar{% endblock %}

{% block body %}
<div class="bg-[#f8fafc] py-6 sm:py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">

        <!-- Top Navigation & Security Header -->
        <div class="flex items-center justify-between text-xs">
            <a href="{{ path('app_trip_show', {id: trip.id, from: boardingStop.id, to: alightingStop.id}) }}" class="font-bold text-brand-700 hover:text-brand-800 flex items-center gap-1.5 transition">
                {{ ux_icon('lucide:arrow-right', {class: 'w-3.5 h-3.5 rotate-180'}) }}
                <span>Retour aux détails du trajet</span>
            </a>
            <div class="inline-flex items-center gap-1.5 text-slate-500 font-medium">
                {{ ux_icon('lucide:shield-check', {class: 'w-4 h-4 text-emerald-600'}) }}
                <span>Plateforme sécurisée CMI & ANRT</span>
            </div>
        </div>

        <!-- 3-Step Progress Bar (Matching Stitch Screen S03) -->
        <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
            <div class="grid grid-cols-3 gap-2 text-center text-xs">
                <!-- Step 1 -->
                <div class="flex items-center justify-center gap-2 text-emerald-700 font-bold">
                    <span class="w-6 h-6 rounded-full bg-emerald-100 border border-emerald-300 flex items-center justify-center text-xs">
                        {{ ux_icon('lucide:check', {class: 'w-3.5 h-3.5 text-emerald-700'}) }}
                    </span>
                    <span class="hidden sm:inline">ÉTAPE 1</span>
                    <span class="text-slate-600 font-medium hidden md:inline">Sélection trajet</span>
                </div>
                <!-- Step 2 -->
                <div class="flex items-center justify-center gap-2 text-emerald-700 font-bold border-x border-slate-100">
                    <span class="w-6 h-6 rounded-full bg-emerald-100 border border-emerald-300 flex items-center justify-center text-xs">
                        {{ ux_icon('lucide:check', {class: 'w-3.5 h-3.5 text-emerald-700'}) }}
                    </span>
                    <span class="hidden sm:inline">ÉTAPE 2</span>
                    <span class="text-slate-600 font-medium hidden md:inline">Coordonnées</span>
                </div>
                <!-- Step 3 (Active) -->
                <div class="flex items-center justify-center gap-2 text-slate-900 font-extrabold">
                    <span class="w-6 h-6 rounded-full bg-brand-600 text-white flex items-center justify-center text-xs shadow-sm">3</span>
                    <span>ÉTAPE 3</span>
                    <span class="text-slate-500 font-medium hidden md:inline">Paiement & Confirmation</span>
                </div>
            </div>
        </div>

        <!-- Main Checkout Content (Two Columns) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left Column: Checkout Form & Policies (~7 cols) -->
            <div class="lg:col-span-7 space-y-6">
                
                <!-- Title Header -->
                <div>
                    <div class="flex items-center gap-2 text-xs mb-2">
                        <span class="text-slate-400">•</span>
                        <span class="text-slate-500 font-semibold text-[11px]">Réservation instantanée</span>
                    </div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                        Finaliser votre réservation
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-500 mt-1">
                        Trajet direct {{ boardingStop.city.name }} → {{ alightingStop.city.name }} avec chauffeur certifié SafarCar Prestige.
                    </p>

                    <!-- Demo Environment Notice -->
                    <div class="mt-3 inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-semibold">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Environnement sécurisé de démonstration • Aucun débit bancaire réel</span>
                    </div>
                </div>

                <!-- Card 1: Passager & Contact vérifié -->
                <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-brand-600 flex items-center justify-center">
                                {{ ux_icon('lucide:user', {class: 'w-4 h-4'}) }}
                            </div>
                            <h2 class="text-sm font-bold text-slate-900">Passager & Contact vérifié</h2>
                        </div>
                        <span class="inline-flex items-center gap-1 text-[10px] font-extrabold bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full border border-emerald-200">
                            {{ ux_icon('lucide:check', {class: 'w-3 h-3 text-emerald-600'}) }} VÉRIFIÉ
                        </span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                        <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/80">
                            <span class="text-[10px] text-slate-400 font-bold uppercase block mb-0.5">NOM COMPLET</span>
                            <span class="font-extrabold text-slate-900 text-sm">
                                {{ passenger ? passenger.firstname ~ ' ' ~ passenger.lastname : 'Amina Benjelloun' }}
                            </span>
                        </div>
                        <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/80">
                            <span class="text-[10px] text-slate-400 font-bold uppercase block mb-0.5">TÉLÉPHONE WHATSAPP</span>
                            <span class="font-extrabold text-slate-900 text-sm font-mono">
                                {{ passenger ? passenger.phone|default('+212 661-234567') : '+212 661-234567' }}
                            </span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between text-[11px] text-slate-500 pt-1">
                        <span class="flex items-center gap-1.5">
                            {{ ux_icon('lucide:phone', {class: 'w-3.5 h-3.5 text-emerald-600'}) }} Confirmation envoyée par WhatsApp dès validation
                        </span>
                        <a href="{{ path('app_passenger_bookings') }}" class="text-brand-600 font-bold hover:underline">Modifier</a>
                    </div>
                </div>

                <!-- Form submitting to confirm route -->
                <form action="{{ path('app_trip_checkout_confirm', {id: trip.id}) }}" method="POST" class="space-y-6">
                    <input type="hidden" name="from" value="{{ boardingStop.id }}">
                    <input type="hidden" name="to" value="{{ alightingStop.id }}">
                    <input type="hidden" name="seats" value="{{ seats }}">

                    <!-- Card 2: Modes de règlement au Maroc -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-emerald-50 text-brand-600 flex items-center justify-center">
                                    {{ ux_icon('lucide:credit-card', {class: 'w-4 h-4'}) }}
                                </div>
                                <h2 class="text-sm font-bold text-slate-900">Modes de règlement au Maroc</h2>
                            </div>
                            <span class="inline-flex items-center gap-1 text-[10px] font-extrabold bg-slate-100 text-slate-600 px-2 py-0.5 rounded border border-slate-200">
                                {{ ux_icon('lucide:shield-check', {class: 'w-3 h-3 text-slate-500'}) }} PROTÉGÉ CMI
                            </span>
                        </div>

                        <div class="space-y-3">
                            <!-- Option 1: Simulated Express (Checked by default) -->
                            <label class="block p-4 rounded-xl border-2 border-brand-500 bg-emerald-50/40 cursor-pointer transition">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex items-start gap-3">
                                        <input type="radio" name="payment_method" value="simulated" checked class="mt-1 text-brand-600 focus:ring-brand-500">
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <span class="font-extrabold text-slate-900 text-xs">Paiement simulé SafarCar Express</span>
                                                <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-brand-600 text-white">RECOMMANDÉ</span>
                                                <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-emerald-100 text-emerald-800">SANS FRAIS</span>
                                            </div>
                                            <p class="text-[11px] text-slate-600 mt-1 leading-relaxed">
                                                Validation immédiate du siège dans le système. Billet numérique et reçu instantanément émis sans saisie de coordonnées bancaires.
                                            </p>
                                            <div class="flex items-center gap-3 mt-2 text-[10px] text-slate-500 font-semibold">
                                                <span class="flex items-center gap-1">{{ ux_icon('lucide:check', {class: 'w-3 h-3 text-emerald-600'}) }} 0 DH de frais de dossier</span>
                                                <span>•</span>
                                                <span class="flex items-center gap-1">{{ ux_icon('lucide:sparkles', {class: 'w-3 h-3 text-amber-500'}) }} Billet instantané</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <!-- Option 2: Carte Bancaire CMI -->
                            <label class="block p-4 rounded-xl border border-slate-200 hover:border-slate-300 cursor-pointer transition">
                                <div class="flex items-start gap-3">
                                    <input type="radio" name="payment_method" value="cmi" class="mt-1 text-brand-600 focus:ring-brand-500">
                                    <div class="flex-1">
                                        <div class="font-bold text-slate-900 text-xs">Carte bancaire marocaine (CMI / Visa / Mastercard)</div>
                                        <p class="text-[11px] text-slate-500 mt-0.5">
                                            Toutes banques marocaines (Attijari, BCP, BMCE, CIH, Crédit du Maroc, SG). Protocole 3D-Secure 2.0.
                                        </p>
                                        <div class="flex items-center gap-2 mt-2">
                                            <span class="px-2 py-0.5 bg-slate-100 rounded text-[10px] font-bold text-slate-600 border border-slate-200">CMI Maroc</span>
                                            <span class="px-2 py-0.5 bg-slate-100 rounded text-[10px] font-bold text-slate-600 border border-slate-200">Visa</span>
                                            <span class="px-2 py-0.5 bg-slate-100 rounded text-[10px] font-bold text-slate-600 border border-slate-200">Mastercard</span>
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <!-- Option 3: Espèces au conducteur -->
                            <label class="block p-4 rounded-xl border border-slate-200 hover:border-slate-300 cursor-pointer transition">
                                <div class="flex items-start gap-3">
                                    <input type="radio" name="payment_method" value="cash" class="mt-1 text-brand-600 focus:ring-brand-500">
                                    <div class="flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-slate-900 text-xs">Paiement en espèces au conducteur</span>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200">Avec empreinte</span>
                                        </div>
                                        <p class="text-[11px] text-slate-500 mt-0.5">
                                            Réglez {{ totalPrice }} DH en dirhams directement au conducteur à l'embarquement à {{ boardingStop.city.name }}. Votre place reste garantie par SafarCar.
                                        </p>
                                    </div>
                                </div>
                            </label>
                        </div>

                        <div class="flex flex-wrap items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-100">
                            <span class="inline-flex items-center gap-1">{{ ux_icon('lucide:lock', {class: 'w-3 h-3 text-slate-400'}) }} Chiffrement SSL 256-bit certifié CMI & ANRT</span>
                            <span>SafarCar Trust & Safety Maroc</span>
                        </div>
                    </div>

                    <!-- Card 3: Conditions d'annulation flexibles (T-203 Rules) -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-3">
                        <div class="flex items-center gap-2">
                            <div class="w-7 h-7 rounded-lg bg-emerald-50 text-brand-600 flex items-center justify-center">
                                {{ ux_icon('lucide:shield', {class: 'w-4 h-4'}) }}
                            </div>
                            <div>
                                <h3 class="text-xs font-bold text-slate-900">Conditions d'annulation flexibles</h3>
                                <div class="text-[10px] text-slate-400">Transparence totale pour les passagers SafarCar</div>
                            </div>
                        </div>

                        <div class="space-y-2 text-xs">
                            <div class="p-3 bg-emerald-50/60 rounded-xl border border-emerald-200/80 text-emerald-900">
                                <span class="font-bold">● Plus de 24h avant le départ :</span> Remboursement intégral garanti à 100% sans justificatif.
                            </div>
                            <div class="p-3 bg-amber-50/60 rounded-xl border border-amber-200/80 text-amber-900">
                                <span class="font-bold">● Moins de 24h avant le départ :</span> Retenue forfaitaire de 50% reversée au conducteur pour compensation du siège réservé.
                            </div>
                        </div>

                        <div class="p-2.5 bg-slate-50 rounded-lg text-[11px] text-slate-600 flex items-center gap-1.5">
                            {{ ux_icon('lucide:sparkles', {class: 'w-3.5 h-3.5 text-amber-500 shrink-0'}) }}
                            <span>Remboursement instantané recrédité sans aucun délai administratif.</span>
                        </div>
                    </div>

                    <!-- 3 Trust Pill Badges -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                        <div class="p-3 bg-white rounded-xl border border-slate-200 text-center">
                            {{ ux_icon('lucide:check-circle-2', {class: 'w-5 h-5 mx-auto text-emerald-600 mb-1'}) }}
                            <div class="font-bold text-slate-900">Garantie de place</div>
                            <div class="text-[10px] text-slate-400">Siège réservé et verrouillé</div>
                        </div>
                        <div class="p-3 bg-white rounded-xl border border-slate-200 text-center">
                            {{ ux_icon('lucide:phone', {class: 'w-5 h-5 mx-auto text-emerald-600 mb-1'}) }}
                            <div class="font-bold text-slate-900">Assistance 24/7</div>
                            <div class="text-[10px] text-slate-400">Support dédié au Maroc</div>
                        </div>
                        <div class="p-3 bg-white rounded-xl border border-slate-200 text-center">
                            {{ ux_icon('lucide:wallet', {class: 'w-5 h-5 mx-auto text-emerald-600 mb-1'}) }}
                            <div class="font-bold text-slate-900">Remboursement direct</div>
                            <div class="text-[10px] text-slate-400">En cas d'imprévu</div>
                        </div>
                    </div>

                    <!-- Big Confirmation CTA Button -->
                    <div class="space-y-2">
                        <button type="submit" class="w-full py-4 px-6 bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-extrabold text-sm rounded-xl shadow-xl shadow-brand-900/25 transition flex items-center justify-center gap-2 group">
                            {{ ux_icon('lucide:check', {class: 'w-4 h-4 text-white'}) }}
                            <span>Confirmer et payer {{ totalPrice }} DH</span>
                            {{ ux_icon('lucide:arrow-right', {class: 'w-4 h-4 group-hover:translate-x-1 transition duration-150'}) }}
                        </button>
                        <div class="text-center">
                            <a href="{{ path('app_trip_show', {id: trip.id}) }}" class="text-xs text-slate-400 hover:text-slate-600 hover:underline">
                                Annuler et revenir au trajet
                            </a>
                        </div>
                    </div>
                </form>

            </div>

            <!-- Right Column: Sticky Trip Summary Card (~5 cols) -->
            <div class="lg:col-span-5 sticky top-24">
                <div class="bg-white rounded-2xl border border-slate-200 shadow-xl p-6 space-y-5">
                    
                    <!-- Header -->
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                        <div class="flex items-center gap-2 font-extrabold text-slate-900 text-sm">
                            {{ ux_icon('lucide:file-text', {class: 'w-4 h-4 text-brand-700'}) }}
                            <span>Récapitulatif du trajet</span>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold text-[10px] uppercase">
                            DIRECT AUTOROUTE
                        </span>
                    </div>

                    <!-- Driver Snippet -->
                    <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200/80">
                        <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-800 font-extrabold text-xs flex items-center justify-center border border-emerald-300 flex-shrink-0">
                            {{ trip.driver.firstName|slice(0, 1) }}{{ trip.driver.lastName|slice(0, 1) }}
                        </div>
                        <div class="text-xs">
                            <div class="flex items-center gap-1.5">
                                <span class="font-bold text-slate-900">{{ trip.driver.firstName }} {{ trip.driver.lastName|slice(0, 1) }}.</span>
                                <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-emerald-100 text-emerald-800">Conducteur Pro</span>
                            </div>
                            <div class="text-slate-500 text-[11px] mt-0.5 flex items-center gap-1">
                                {{ ux_icon('lucide:star', {class: 'w-3 h-3 fill-amber-400 text-amber-400'}) }}
                                <span>4.9 • 18 avis vérifiés</span>
                            </div>
                            {% if trip.vehicle %}
                                <div class="text-[10px] text-slate-400">
                                    {{ trip.vehicle.brand }} {{ trip.vehicle.model }} • {{ trip.vehicle.color }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Date & Duration -->
                    <div class="text-xs font-semibold text-slate-700 flex items-center justify-between">
                        <span class="flex items-center gap-1.5">
                            {{ ux_icon('lucide:calendar', {class: 'w-3.5 h-3.5 text-slate-500'}) }}
                            <span>{{ trip.departureAt ? trip.departureAt|date('l d F Y') : 'Samedi 14 Novembre 2026' }}</span>
                        </span>
                        <span class="text-slate-400 flex items-center gap-1">
                            {{ ux_icon('lucide:clock', {class: 'w-3 h-3 text-slate-400'}) }}
                            <span>3h45 de route</span>
                        </span>
                    </div>

                    <!-- Timeline -->
                    <div class="space-y-3 text-xs border-l-2 border-emerald-500 pl-3 ml-2">
                        <div>
                            <div class="font-extrabold text-slate-900">
                                {{ boardingStop.estimatedArrivalAt ? boardingStop.estimatedArrivalAt|date('H:i') : trip.departureAt|date('H:i') }} {{ boardingStop.city.name }}
                            </div>
                            <div class="text-[11px] text-slate-500">
                                {{ boardingStop.meetingPoint|default('Gare Routière') }}
                            </div>
                        </div>
                        <div>
                            <div class="font-extrabold text-slate-900">
                                {{ alightingStop.estimatedArrivalAt ? alightingStop.estimatedArrivalAt|date('H:i') : '12:30' }} {{ alightingStop.city.name }}
                            </div>
                            <div class="text-[11px] text-slate-500">
                                {{ alightingStop.meetingPoint|default('Gare ONCF / Centre-ville') }}
                            </div>
                        </div>
                    </div>

                    <!-- Info Rows -->
                    <div class="border-t border-slate-100 pt-3 space-y-2 text-xs">
                        <div class="flex justify-between text-slate-600">
                            <span>Nombre de passagers</span>
                            <span class="font-bold text-slate-900">{{ seats }} place{% if seats > 1 %}s{% endif %}</span>
                        </div>
                        <div class="flex justify-between text-slate-600">
                            <span>Tronçon sélectionné</span>
                            <span class="font-bold text-slate-900">{{ segmentsCount }} segment{% if segmentsCount > 1 %}s{% endif %}</span>
                        </div>
                        <div class="flex justify-between text-slate-600">
                            <span>Tarif place passager</span>
                            <span class="font-bold text-slate-900">{{ totalPrice }} DH</span>
                        </div>
                        <div class="flex justify-between text-slate-600">
                            <span>Frais de service SafarCar</span>
                            <span class="font-semibold text-emerald-600">0 DH (Offerts)</span>
                        </div>
                        <div class="flex justify-between text-slate-600">
                            <span>Assurance trajet incluse</span>
                            <span class="font-semibold text-emerald-600">Gratuit</span>
                        </div>

                        <div class="border-t border-slate-200 pt-3 flex justify-between items-baseline">
                            <span class="text-sm font-extrabold text-slate-900">Total à régler :</span>
                            <span class="text-2xl font-extrabold text-slate-900">{{ totalPrice }} DH</span>
                        </div>
                        <div class="text-[10px] text-slate-400 text-right">
                            TVA & assurances incluses • 0 DH de frais cachés
                        </div>
                    </div>

                    <!-- Trust banner -->
                    <div class="p-3 bg-emerald-50 rounded-xl border border-emerald-200 text-emerald-800 text-[11px] font-semibold flex items-center gap-2">
                        {{ ux_icon('lucide:check-circle-2', {class: 'w-4 h-4 text-emerald-700 shrink-0'}) }}
                        <span>Place réservée et garantie avec assistance voyage</span>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
{% endblock %}
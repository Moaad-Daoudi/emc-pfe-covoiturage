{% extends 'base.html.twig' %}

{% block title %}Mes réservations — SafarCar Maroc{% endblock %}

{% block body %}
<div class="bg-[#f8fafc] py-6 sm:py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

        <!-- 1. Breadcrumbs & Header -->
        <div class="space-y-4">
            <div class="flex items-center justify-between text-xs">
                <div class="flex items-center gap-2 text-slate-500">
                    <a href="{{ path('app_home') }}" class="hover:text-slate-800">Accueil</a>
                    <span>></span>
                    <span class="font-bold text-slate-800">Mes réservations</span>
                </div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    ESPACE PASSAGER PRIVILÈGE
                </span>
            </div>

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                <div>
                    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
                        Mes réservations
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-xl">
                        Suivez vos itinéraires en temps réel, visualisez vos e-billets et gérez vos remboursements instantanés en toute sérénité.
                    </p>
                </div>

                <!-- 3 Top Metric KPI Cards -->
                <div class="grid grid-cols-3 gap-3 flex-shrink-0 text-xs">
                    <!-- KPI 1 -->
                    <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg flex-shrink-0">
                            🎫
                        </div>
                        <div>
                            <div class="text-[10px] font-bold text-slate-400 uppercase">Trajets à venir</div>
                            <div class="text-base font-extrabold text-slate-900">{{ upcomingCount }} confirmé{% if upcomingCount > 1 %}s{% endif %}</div>
                        </div>
                    </div>

                    <!-- KPI 2 -->
                    <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center text-lg flex-shrink-0">
                            💰
                        </div>
                        <div>
                            <div class="text-[10px] font-bold text-slate-400 uppercase">Économies</div>
                            <div class="text-base font-extrabold text-slate-900">{{ totalSavings }} DH</div>
                        </div>
                    </div>

                    <!-- KPI 3 -->
                    <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg flex-shrink-0">
                            🌱
                        </div>
                        <div>
                            <div class="text-[10px] font-bold text-slate-400 uppercase">CO₂ Évité</div>
                            <div class="text-base font-extrabold text-slate-900">-{{ co2Avoided }} kg</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Tabs Navigation Bar -->
        <div class="flex items-center justify-between border-b border-slate-200 pb-1 text-xs">
            <div class="flex items-center gap-6">
                <button type="button" class="pb-3 border-b-2 border-brand-600 font-extrabold text-brand-700 flex items-center gap-2">
                    <span>Trajets à venir</span>
                    <span class="w-5 h-5 rounded-full bg-brand-100 text-brand-700 text-[11px] flex items-center justify-center font-bold">
                        {{ upcomingCount }}
                    </span>
                </button>
                <a href="#past-trips" class="pb-3 text-slate-500 hover:text-slate-800 font-semibold flex items-center gap-2">
                    <span>Historique & Archivés</span>
                    <span class="w-5 h-5 rounded-full bg-slate-100 text-slate-600 text-[11px] flex items-center justify-center font-bold">
                        {{ pastBookings|length }}
                    </span>
                </a>
            </div>

            <div class="hidden sm:flex items-center gap-1.5 text-slate-400 text-[11px]">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>Synchronisé avec le réseau ONCF / Autoroutes</span>
            </div>
        </div>

        <!-- 3. List of Upcoming Bookings -->
        <div class="space-y-6">
            {% if upcomingBookings is not empty %}
                {% for b in upcomingBookings %}
                    {% set trip = b.trip %}
                    {% set bStop = b.boardingStop %}
                    {% set aStop = b.alightingStop %}

                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-5 hover:border-brand-200 transition">
                        
                        <!-- Header Row -->
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 pb-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold">
                                    📅
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-sm font-extrabold text-slate-900">
                                            {{ trip.departureAt ? trip.departureAt|date('l d F Y') : 'Samedi 14 Novembre 2026' }}
                                        </h3>
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 text-[10px] font-bold border border-emerald-200">
                                            <span>●</span> Confirmée & Garantie
                                        </span>
                                    </div>
                                    <div class="text-[11px] text-slate-400 mt-0.5 flex items-center gap-2">
                                        <span>Réf. : SC-{{ b.id * 73 }}</span>
                                        <span>•</span>
                                        <span class="text-amber-600 font-semibold flex items-center gap-1">
                                            <span>⏳</span> Départ prochain
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="text-right">
                                <div class="text-2xl font-extrabold text-slate-900 tracking-tight">{{ b.totalPrice }} DH</div>
                                <div class="text-[11px] text-slate-400">{{ b.seatsBooked }} place{% if b.seatsBooked > 1 %}s{% endif %} réservée{% if b.seatsBooked > 1 %}s{% endif %}</div>
                            </div>
                        </div>

                        <!-- Main Row: Timeline + Driver Info -->
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                            
                            <!-- Timeline (7 cols) -->
                            <div class="lg:col-span-7 space-y-4">
                                <!-- Boarding Stop -->
                                <div class="flex items-start gap-3">
                                    <div class="flex flex-col items-center flex-shrink-0">
                                        <span class="w-3.5 h-3.5 rounded-full border-2 border-emerald-600 bg-white"></span>
                                        <span class="w-0.5 h-10 bg-slate-200 my-0.5"></span>
                                    </div>
                                    <div class="flex-1 -mt-0.5">
                                        <div class="flex items-baseline justify-between">
                                            <div class="flex items-baseline gap-2">
                                                <span class="text-base font-extrabold text-slate-900">
                                                    {{ bStop.estimatedArrivalAt ? bStop.estimatedArrivalAt|date('H:i') : trip.departureAt|date('H:i') }}
                                                </span>
                                                <span class="text-sm font-bold text-slate-800">{{ bStop.city.name }}</span>
                                            </div>
                                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">DÉPART</span>
                                        </div>
                                        <div class="text-xs text-slate-500 font-medium">
                                            {{ bStop.meetingPoint|default('Gare Routière (Point de rendez-vous principal)') }}
                                        </div>
                                    </div>
                                </div>

                                <!-- Segment Info Pills -->
                                <div class="ml-4 pl-4 py-1 flex items-center gap-2 text-[11px]">
                                    <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-medium">3h45 • Via Autoroute</span>
                                    {% if trip.vehicle and trip.vehicle.isAirConditioned %}
                                        <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-medium">Climatisation active</span>
                                    {% endif %}
                                </div>

                                <!-- Alighting Stop -->
                                <div class="flex items-start gap-3">
                                    <div class="flex flex-col items-center flex-shrink-0">
                                        <span class="w-3.5 h-3.5 rounded-full bg-emerald-600"></span>
                                    </div>
                                    <div class="flex-1 -mt-0.5">
                                        <div class="flex items-baseline justify-between">
                                            <div class="flex items-baseline gap-2">
                                                <span class="text-base font-extrabold text-slate-900">
                                                    {{ aStop.estimatedArrivalAt ? aStop.estimatedArrivalAt|date('H:i') : '12:30' }}
                                                </span>
                                                <span class="text-sm font-bold text-slate-800">{{ aStop.city.name }}</span>
                                            </div>
                                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">ARRIVÉE</span>
                                        </div>
                                        <div class="text-xs text-slate-500 font-medium">
                                            {{ aStop.meetingPoint|default('Gare ONCF / Dépose-minute esplanade') }}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Driver Box (5 cols) -->
                            <div class="lg:col-span-5 bg-slate-50 rounded-xl p-4 border border-slate-200/80 space-y-3">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 font-extrabold text-xs flex items-center justify-center border border-emerald-300">
                                            {{ trip.driver.firstName|slice(0, 1) }}{{ trip.driver.lastName|slice(0, 1) }}
                                        </div>
                                        <div class="text-xs">
                                            <div class="flex items-center gap-1.5 font-bold text-slate-900">
                                                <span>{{ trip.driver.firstName }} {{ trip.driver.lastName|slice(0, 1) }}.</span>
                                                <span class="text-emerald-600">✓</span>
                                            </div>
                                            <div class="text-[11px] text-amber-500 font-semibold">
                                                ★ 4.9 <span class="text-slate-400 font-normal">(18 avis certifiés)</span>
                                            </div>
                                        </div>
                                    </div>
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                        Super Conducteur
                                    </span>
                                </div>

                                {% if trip.vehicle %}
                                    <div class="text-[11px] text-slate-600 space-y-0.5 border-t border-slate-200/60 pt-2">
                                        <div class="flex justify-between font-bold">
                                            <span>{{ trip.vehicle.brand }} {{ trip.vehicle.model }}</span>
                                            <span class="font-mono text-[10px] text-slate-400">{{ trip.vehicle.licensePlate|default('12-A-87421') }}</span>
                                        </div>
                                        <div class="text-slate-400 text-[10px]">{{ trip.vehicle.color }} • Coffre spacieux (2 bagages autorisés)</div>
                                    </div>
                                {% endif %}

                                <div class="grid grid-cols-2 gap-2 pt-1 text-xs">
                                    <a href="tel:{{ trip.driver.phone|default('+212600000000') }}" class="py-1.5 px-3 bg-white hover:bg-slate-100 rounded-lg border border-slate-200 font-bold text-slate-700 text-center flex items-center justify-center gap-1 transition">
                                        <span>📞</span> Appeler
                                    </a>
                                    <a href="https://wa.me/212661234567" target="_blank" class="py-1.5 px-3 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg font-bold text-center flex items-center justify-center gap-1 transition">
                                        <span>💬</span> WhatsApp
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Bottom Action Bar (Policy & Actions) -->
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-t border-slate-100 pt-3 text-xs">
                            <div class="text-[11px] text-slate-500 flex items-center gap-1.5">
                                <span class="text-emerald-600 font-bold">✓</span>
                                <span>Annulation 100% sans frais jusqu'à 24h avant départ (H-24)</span>
                            </div>

                            <div class="flex items-center gap-2 flex-wrap">
                                <button type="button" onclick="alert('Billet numérique SafarCar #SC-{{ b.id * 73 }}\nPassager : {{ passenger ? passenger.firstname ~ ' ' ~ passenger.lastname : 'Amina' }}\nTrajet : {{ bStop.city.name }} → {{ aStop.city.name }}\nSièges : {{ b.seatsBooked }}\nMontant : {{ b.totalPrice }} DH');" class="py-2 px-3.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold rounded-xl border border-emerald-200 transition flex items-center gap-1.5">
                                    <span>🎫</span> Billet d'embarquement
                                </button>
                                
                                <a href="{{ path('app_trip_show', {id: trip.id}) }}" class="py-2 px-3 bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold rounded-xl border border-slate-200 transition flex items-center gap-1">
                                    <span>🗺</span> Itinéraire
                                </a>

                                <!-- T-203 Cancellation Button Trigger -->
                                <form action="{{ path('app_booking_cancel', {id: b.id}) }}" method="POST" onsubmit="return confirm('Confirmer l’annulation de votre réservation #SC-{{ b.id * 73 }} ?\n\nConformément aux règles SafarCar (T-203) :\n- Si > 24h avant départ : 100% remboursé.\n- Si < 24h : 50% remboursé.\n\nVotre siège sera immédiatement remis en vente.');" class="inline">
                                    <button type="submit" class="py-2 px-3 bg-white hover:bg-rose-50 text-rose-600 hover:text-rose-700 font-bold rounded-xl border border-rose-200 transition flex items-center gap-1">
                                        <span>🚫</span> Annuler la place
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>
                {% endfor %}
            {% else %}
                <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center shadow-sm">
                    <div class="w-12 h-12 rounded-full bg-emerald-50 text-brand-600 mx-auto flex items-center justify-center text-xl mb-3">
                        🚗
                    </div>
                    <h3 class="text-base font-extrabold text-slate-900 mb-1">Aucun trajet à venir</h3>
                    <p class="text-xs text-slate-500 mb-4 max-w-sm mx-auto">
                        Vous n'avez pas de réservation active pour le moment. Trouvez un trajet régional à travers le Maroc dès maintenant !
                    </p>
                    <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl transition">
                        <span>Rechercher un trajet</span>
                        <span>→</span>
                    </a>
                </div>
            {% endif %}
        </div>

        <!-- 4. Past & Archived Trips Section (Screen S04) -->
        <div id="past-trips" class="space-y-4 pt-6 border-t border-slate-200">
            <div class="flex items-center justify-between text-xs">
                <h2 class="font-extrabold text-slate-400 uppercase tracking-wider text-[11px]">
                    Historique des voyages passés
                </h2>
                <span class="text-slate-400">{{ pastBookings|length }} trajet{% if pastBookings|length > 1 %}s{% endif %} archivé{% if pastBookings|length > 1 %}s{% endif %}</span>
            </div>

            {% if pastBookings is not empty %}
                <div class="space-y-3">
                    {% for pb in pastBookings %}
                        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-xs">
                            <div class="flex items-start gap-3">
                                <div class="w-8 h-8 rounded-lg {% if pb.status.value == 'CANCELLED_PASSENGER' or pb.status.value == 'CANCELLED_DRIVER' %}bg-rose-50 text-rose-600{% else %}bg-blue-50 text-blue-600{% endif %} flex items-center justify-center font-bold flex-shrink-0">
                                    {% if pb.status.value == 'CANCELLED_PASSENGER' or pb.status.value == 'CANCELLED_DRIVER' %}✕{% else %}✓{% endif %}
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold text-slate-900">
                                            {{ pb.trip.departureAt ? pb.trip.departureAt|date('d/m/Y • H:i') : 'Date passée' }}
                                        </span>
                                        {% if pb.status.value == 'CANCELLED_PASSENGER' %}
                                            <span class="px-2 py-0.2 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                Annulée par vous • Remboursé {{ pb.refundAmount|default(110) }} DH
                                            </span>
                                        {% elseif pb.status.value == 'CANCELLED_DRIVER' %}
                                            <span class="px-2 py-0.2 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                Annulée par le conducteur • 100% Remboursé
                                            </span>
                                        {% else %}
                                            <span class="px-2 py-0.2 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                                Voyage effectué
                                            </span>
                                        {% endif %}
                                    </div>
                                    <div class="text-slate-600 font-medium mt-0.5">
                                        {{ pb.boardingStop ? pb.boardingStop.city.name : pb.trip.departureCity.name }} → {{ pb.alightingStop ? pb.alightingStop.city.name : pb.trip.arrivalCity.name }}
                                        <span class="text-slate-400">• Conducteur : {{ pb.trip.driver.firstName }} {{ pb.trip.driver.lastName|slice(0, 1) }}.</span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-3 justify-end flex-shrink-0">
                                <div class="text-right">
                                    <div class="font-extrabold text-slate-900">{{ pb.totalPrice }} DH</div>
                                    <div class="text-[10px] text-slate-400">Paiement clôturé</div>
                                </div>
                                {% if pb.status.value != 'CANCELLED_PASSENGER' and pb.status.value != 'CANCELLED_DRIVER' %}
                                    <button type="button" onclick="alert('Évaluation du conducteur {{ pb.trip.driver.firstName }} pour le trajet #SC-{{ pb.id * 73 }}.\nMerci de partager votre expérience 5 étoiles !');" class="py-1.5 px-3 rounded-lg border border-amber-200 bg-amber-50 text-amber-800 font-bold hover:bg-amber-100 transition flex items-center gap-1">
                                        <span>★</span> Évaluer le conducteur
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <!-- 5. AXA Insurance Bottom Card -->
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-xs">
            <div class="flex items-center gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl flex-shrink-0">
                    🛡
                </div>
                <div>
                    <h3 class="font-extrabold text-slate-900 text-sm">Assurance AXA Maroc & Remboursement Garanti</h3>
                    <p class="text-slate-500 text-[11px] mt-0.5">
                        Chaque passager SafarCar bénéficie d'une couverture corporelle complète, assistance panne 24h/7j et d'un remboursement intégral garanti en cas d'annulation H-24.
                    </p>
                </div>
            </div>
            <button type="button" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 font-bold hover:bg-slate-50 transition flex-shrink-0">
                Consulter les garanties
            </button>
        </div>

    </div>
</div>
{% endblock %}
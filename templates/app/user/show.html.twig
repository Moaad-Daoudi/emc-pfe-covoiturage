{% extends 'base.html.twig' %}

{% block title %}{{ user.firstname }} {{ user.lastname }} — Profil Vérifié SafarCar{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">

    <!-- Breadcrumb & Trust Badge -->
    <div class="flex items-center justify-between text-xs font-medium">
        <a href="javascript:history.back()" class="text-slate-500 hover:text-emerald-700 transition flex items-center gap-1 font-semibold">
            <span>←</span>
            <span>Retour</span>
            <span class="text-slate-300 mx-1">/</span>
            <span class="text-slate-500">Membres SafarCar</span>
            <span class="text-slate-300 mx-1">/</span>
            <span class="text-slate-900 font-bold">{{ user.firstname }} {{ user.lastname }}</span>
        </a>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-semibold">
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Profil vérifié CNI & Permis
        </span>
    </div>

    <!-- User Profile Card Hero -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-6 border-b border-slate-100">
            <div class="flex items-start sm:items-center gap-5">
                <div class="relative shrink-0">
                    <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-slate-900 text-white font-extrabold text-2xl sm:text-3xl flex items-center justify-center border-4 border-emerald-100 shadow-md">
                        {{ user.firstname|first|upper }}{{ user.lastname|first|upper }}
                    </div>
                    <span class="absolute bottom-1 right-1 w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs font-bold border-2 border-white shadow-xs">
                        ✓
                    </span>
                </div>

                <div class="space-y-1.5">
                    <div class="flex flex-wrap items-center gap-2.5">
                        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                            {{ user.firstname }} {{ user.lastname }}
                        </h1>
                        <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200/80">
                            ✓ CNI & Permis B validés
                        </span>
                    </div>

                    <p class="text-xs sm:text-sm text-slate-500 flex flex-wrap items-center gap-3">
                        <span>📍 Agadir, Maroc</span>
                        <span>•</span>
                        <span>📅 Membre depuis mars 2024</span>
                    </p>

                    <div class="flex items-center gap-2 pt-1">
                        <span class="text-xs font-bold text-slate-700 bg-slate-100 px-2.5 py-0.5 rounded-lg">
                            Conductrice certifiée
                        </span>
                        <span class="text-xs font-semibold text-slate-500 bg-slate-50 px-2.5 py-0.5 rounded-lg border border-slate-200/60">
                            Passagère régulière
                        </span>
                    </div>
                </div>
            </div>

            <button type="button" onclick="alert('Messagerie sécurisée SafarCar ouverte avec {{ user.firstname }}.')"
                class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-sm shadow-md shadow-emerald-700/20 hover:scale-[1.01] transition shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                <span>Contacter {{ user.firstname }}</span>
            </button>
        </div>

        <!-- Biography Quote -->
        <blockquote class="text-sm sm:text-base text-slate-600 italic bg-slate-50/80 p-5 rounded-2xl border border-slate-200/70 leading-relaxed">
            « {{ user.bio|default("Passionnée de voyages et d'échanges culturels. Je fais régulièrement la navette entre Agadir, Essaouira et Marrakech pour des raisons professionnelles. Conduite souple, ponctualité rigoureuse, musique douce et respect total de l'espace de chacun.") }} »
        </blockquote>

        <!-- 3 Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/70">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Note Moyenne</span>
                <div class="flex items-center gap-2 mt-1">
                    <span class="text-2xl font-extrabold text-slate-900">{{ stats.average|default(4.9) }}</span>
                    <span class="text-sm text-slate-400">/ 5.0</span>
                    <span class="text-amber-400 text-sm">★★★★★</span>
                </div>
                <span class="text-xs text-slate-500 mt-1 block">Sur {{ stats.count|default(19) }} avis certifiés SafarCar</span>
            </div>

            <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/70">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Trajets Interurbains</span>
                <div class="text-2xl font-extrabold text-slate-900 mt-1">
                    28 <span class="text-sm font-semibold text-slate-500">trajets</span>
                </div>
                <span class="text-xs text-slate-500 mt-1 block">18 en conductrice · 10 passagers</span>
            </div>

            <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/70">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Taux de Ponctualité</span>
                <div class="text-2xl font-extrabold text-emerald-700 mt-1">
                    100% <span class="text-sm font-semibold text-slate-500">fiable</span>
                </div>
                <span class="text-xs text-slate-500 mt-1 block">0 annulation · Réponse < 15 min</span>
            </div>
        </div>
    </div>

    <!-- Vérifications & Conformité Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2">
                <span class="text-emerald-600">🛡</span>
                <h2 class="text-base font-bold text-slate-900 tracking-tight">Vérifications & Conformité</h2>
            </div>
            <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                Profil de Confiance 100%
            </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/70">
                <span class="text-xs font-bold text-slate-800 block">CNI Nationale</span>
                <span class="text-[11px] text-emerald-700 font-medium">✓ Certifiée CNDP</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/70">
                <span class="text-xs font-bold text-slate-800 block">Permis de conduire</span>
                <span class="text-[11px] text-emerald-700 font-medium">✓ Catégorie B validée</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/70">
                <span class="text-xs font-bold text-slate-800 block">Téléphone vérifié</span>
                <span class="text-[11px] text-emerald-700 font-medium font-mono">✓ +212 6 •• •• 89</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/70">
                <span class="text-xs font-bold text-slate-800 block">Assurance AXA</span>
                <span class="text-[11px] text-emerald-700 font-medium">✓ Passagers protégés</span>
            </div>
        </div>
    </div>

    <!-- Véhicule Déclaré & Confort à bord -->
    <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2">
                <span class="text-emerald-600">🚘</span>
                <h2 class="text-base font-bold text-slate-900 tracking-tight">Véhicule déclaré & Confort à bord</h2>
            </div>
            <span class="text-xs font-semibold text-slate-500">
                Visite technique à jour (2025)
            </span>
        </div>

        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/70 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="space-y-1">
                <div class="flex items-center gap-2">
                    <span class="font-extrabold text-base text-slate-900">Peugeot 208 · Allure</span>
                    <span class="text-xs font-semibold text-slate-500 bg-white px-2 py-0.5 rounded-md border border-slate-200">Gris Métallisé</span>
                </div>
                <p class="text-xs text-slate-500">
                    Immatriculé au Maroc (Série 26 - Marrakech / Agadir)
                </p>
            </div>
            <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 shrink-0">
                👤 Max 2 personnes à l'arrière
            </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs text-slate-700 pt-1">
            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-2">
                <span>❄</span> <span>Climatisation régulée</span>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-2">
                <span>🧳</span> <span>Grand coffre (Valise cabine)</span>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-2">
                <span>🚭</span> <span>Véhicule non-fumeur</span>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-2">
                <span>🐾</span> <span>Animaux non admis</span>
            </div>
        </div>
    </div>

    <!-- Avis de la communauté SafarCar -->
    <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
            <div>
                <h2 class="text-lg font-bold text-slate-900 tracking-tight">Avis de la communauté SafarCar</h2>
                <p class="text-xs text-slate-400 mt-0.5">Avis recueillis après chaque trajet complété et certifiés par SafarCar Maroc</p>
            </div>

            <!-- Tab Filters -->
            <div class="flex items-center gap-1.5 text-xs font-bold">
                <button type="button" class="px-3 py-1.5 rounded-xl bg-slate-900 text-white">Tous (19)</button>
                <button type="button" class="px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200">Conductrice (15)</button>
                <button type="button" class="px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200">Passagère (4)</button>
            </div>
        </div>

        <!-- Rating Sub-Scores Strip -->
        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200/80 grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
            <div>
                <span class="text-slate-500 block">Conduite sécurisée</span>
                <span class="font-extrabold text-sm text-slate-900 mt-0.5 block">5.0 / 5</span>
            </div>
            <div>
                <span class="text-slate-500 block">Communication</span>
                <span class="font-extrabold text-sm text-slate-900 mt-0.5 block">5.0 / 5</span>
            </div>
            <div>
                <span class="text-slate-500 block">Propreté du véhicule</span>
                <span class="font-extrabold text-sm text-slate-900 mt-0.5 block">4.9 / 5</span>
            </div>
            <div>
                <span class="text-slate-500 block">Ambiance à bord</span>
                <span class="font-extrabold text-sm text-slate-900 mt-0.5 block">4.8 / 5</span>
            </div>
        </div>

        <!-- Review Cards List -->
        <div class="space-y-4">
            <!-- Review 1: Youssef Kaddouri -->
            <div class="p-5 rounded-2xl bg-white border border-slate-200/80 space-y-2.5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-slate-800 text-white font-bold text-xs flex items-center justify-center">YK</div>
                        <div>
                            <span class="font-bold text-sm text-slate-900">Youssef Kaddouri ✓</span>
                            <span class="text-xs text-slate-400 block">Trajet Agadir → Marrakech (Tronçon complet autoroute A3)</span>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="text-amber-400 text-sm">★★★★★</span>
                        <span class="text-[11px] text-slate-400 block">Il y a 3 jours</span>
                    </div>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed italic">
                    « Voyage parfait avec Amina ! Conduite très prudente et sécurisante sur l'autoroute A3. Voiture impeccable et très ponctuelle au départ de la gare routière Al Massira. Je recommande les yeux fermés. »
                </p>
            </div>

            <!-- Review 2: Salma Rahimi -->
            <div class="p-5 rounded-2xl bg-white border border-slate-200/80 space-y-2.5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-teal-700 text-white font-bold text-xs flex items-center justify-center">SR</div>
                        <div>
                            <span class="font-bold text-sm text-slate-900">Salma Rahimi ✓</span>
                            <span class="text-xs text-slate-400 block">Trajet Agadir → Essaouira (Route côtière)</span>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="text-amber-400 text-sm">★★★★★</span>
                        <span class="text-[11px] text-slate-400 block">Novembre 2024</span>
                    </div>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed italic">
                    « Excellente expérience de covoiturage. Amina est très sympathique et très arrangeante pour le point de dépose à Bab Doukkala. Discussion très agréable tout le long du trajet. »
                </p>
            </div>

            <!-- Review 3: Mehdi Tazi -->
            <div class="p-5 rounded-2xl bg-white border border-slate-200/80 space-y-2.5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-indigo-700 text-white font-bold text-xs flex items-center justify-center">MT</div>
                        <div>
                            <span class="font-bold text-sm text-slate-900">Mehdi Tazi ✓</span>
                            <span class="text-xs text-slate-400 block">Trajet Essaouira → Marrakech</span>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="text-amber-400 text-sm">★★★★★</span>
                        <span class="text-[11px] text-slate-400 block">Octobre 2024</span>
                    </div>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed italic">
                    « Ponctuelle, voiture propre et climatisée. Pause de 10 min très appréciée à Chichaoua pour un café. Trajet fluide, convivial et sans le moindre stress. »
                </p>
            </div>

            <!-- Review 4: Karim Berrada (Conducteur) -->
            <div class="p-5 rounded-2xl bg-white border border-slate-200/80 space-y-2.5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-emerald-700 text-white font-bold text-xs flex items-center justify-center">KB</div>
                        <div>
                            <span class="font-bold text-sm text-slate-900">Karim Berrada (Conducteur) ✓</span>
                            <span class="text-xs text-slate-400 block">Amina voyageait comme passagère sur Casablanca → Marrakech</span>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="text-amber-400 text-sm">★★★★★</span>
                        <span class="text-[11px] text-slate-400 block">Septembre 2024</span>
                    </div>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed italic">
                    « Passagère modèle ! A l'heure exacte au point de rendez-vous à Casa Oasis, respectueuse et très agréable tout au long de la route. Au plaisir de voyager à nouveau ensemble. »
                </p>
            </div>
        </div>

        <div class="text-center pt-2">
            <button type="button" onclick="alert('Chargement des avis antérieurs certifiés...')"
                class="px-5 py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 transition">
                Afficher les 15 autres avis
            </button>
        </div>
    </div>

    <!-- Charte de Confiance SafarCar Banner -->
    <div class="p-5 rounded-3xl bg-slate-50 border border-slate-200 flex items-center justify-between text-xs text-slate-600">
        <div class="flex items-center gap-3">
            <span class="text-emerald-700 text-lg">🛡</span>
            <span><strong>Charte de confiance SafarCar :</strong> Toutes les réservations sont couvertes par l'assistance 24/7 et le paiement séquestre.</span>
        </div>
        <a href="#charte" class="font-bold text-emerald-700 hover:underline shrink-0">En savoir plus →</a>
    </div>

</div>
{% endblock %}

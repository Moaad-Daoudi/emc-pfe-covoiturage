{% extends 'base.html.twig' %}

{% block title %}Évaluer le voyage — SafarCar Maroc{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-6">

    <!-- Breadcrumb -->
    <div>
        <a href="{{ path('app_passenger_bookings') }}" class="text-xs font-semibold text-slate-500 hover:text-emerald-700 transition flex items-center gap-1.5">
            <span>←</span>
            <span>Retour à mes réservations</span>
        </a>
    </div>

    <!-- Review Form Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-6">
        
        <!-- Trip Header Pill -->
        <div class="flex flex-wrap items-center justify-between gap-2 p-3 rounded-2xl bg-slate-50 border border-slate-200/70 text-xs">
            <span class="text-slate-600 font-medium flex items-center gap-1.5">
                <span>📅</span>
                <span>Trajet effectué le {{ trip.departureAt|date('d M. Y') }} · {{ trip.departureCity.name }} → {{ trip.arrivalCity.name }}</span>
            </span>
            <span class="font-mono font-bold text-slate-500 bg-white px-2 py-0.5 rounded-lg border border-slate-200">
                Terminé #SC-{{ trip.id }}
            </span>
        </div>

        <!-- Driver Profile Header -->
        <div class="flex items-center gap-4 pb-6 border-b border-slate-100">
            <div class="w-14 h-14 rounded-full bg-slate-900 text-white font-extrabold text-lg flex items-center justify-center border-2 border-emerald-500 shadow-sm shrink-0">
                {{ driver.firstname|default('K')|first|upper }}{{ driver.lastname|default('M')|first|upper }}
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
                    Évaluer {{ driver.firstname|default('Karim') }} {{ driver.lastname|default('Mansouri') }}
                </h1>
                <p class="text-xs text-slate-500 mt-0.5 flex items-center gap-1.5">
                    <span class="text-emerald-600 font-semibold">✓ Conducteur certifié CNI</span>
                    <span>•</span>
                    <span>{{ trip.vehicle.brand }} {{ trip.vehicle.model }} ({{ trip.vehicle.color }})</span>
                </p>
            </div>
        </div>

        <form action="{{ path('app_trip_review_create', { id: trip.id }) }}" method="POST" class="space-y-6">
            
            <!-- Global Experience Rating Box -->
            <div class="bg-slate-50/80 p-6 rounded-2xl border border-slate-200/80 text-center space-y-3">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Expérience Globale</span>
                <h2 class="text-base sm:text-lg font-extrabold text-slate-900">
                    Quelle note attribuez-vous à ce voyage ?
                </h2>

                <!-- 5 Stars Stepper -->
                <div class="flex items-center justify-center gap-2 py-1">
                    {% for i in 1..5 %}
                        <button type="button" class="star-btn text-3xl sm:text-4xl text-amber-400 hover:scale-110 transition cursor-pointer" data-rating="{{ i }}">
                            ★
                        </button>
                    {% endfor %}
                    <input type="hidden" name="rating" id="review-rating" value="4">
                </div>

                <div class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-700 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-2xs">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span id="rating-label">Très bien (4 sur 5)</span>
                </div>

                <!-- Points Forts Commutables -->
                <div class="pt-4 border-t border-slate-200/70 space-y-2">
                    <span class="text-xs text-slate-500 block">Points forts remarqués durant la traversée :</span>
                    <div class="flex flex-wrap items-center justify-center gap-2">
                        <button type="button" class="pill-tag px-3 py-1.5 rounded-xl border text-xs font-bold bg-emerald-50 border-emerald-500 text-emerald-800 transition" data-tag="ponctuel">
                            ✓ Ponctuel
                        </button>
                        <button type="button" class="pill-tag px-3 py-1.5 rounded-xl border text-xs font-bold bg-emerald-50 border-emerald-500 text-emerald-800 transition" data-tag="conduite">
                            ✓ Conduite souple & prudente
                        </button>
                        <button type="button" class="pill-tag px-3 py-1.5 rounded-xl border text-xs font-medium border-slate-200 text-slate-600 hover:bg-slate-100 transition" data-tag="proprete">
                            + Véhicule très propre
                        </button>
                        <button type="button" class="pill-tag px-3 py-1.5 rounded-xl border text-xs font-bold bg-emerald-50 border-emerald-500 text-emerald-800 transition" data-tag="ambiance">
                            ✓ Bonne ambiance / Respectueux
                        </button>
                        <button type="button" class="pill-tag px-3 py-1.5 rounded-xl border text-xs font-medium border-slate-200 text-slate-600 hover:bg-slate-100 transition" data-tag="pauses">
                            + Respect des pauses autoroute
                        </button>
                    </div>
                </div>
            </div>

            <!-- Comment Input -->
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <label for="review-comment" class="text-xs font-bold uppercase tracking-wider text-slate-700">
                        Partagez votre expérience
                    </label>
                    <span class="text-[10px] font-bold uppercase text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                        Recommandé
                    </span>
                </div>
                <p class="text-xs text-slate-400">
                    Votre avis sera vérifié par notre équipe puis affiché sur la fiche publique de {{ driver.firstname|default('Karim') }} {{ driver.lastname|default('Mansouri') }}.
                </p>

                <textarea id="review-comment" name="comment" rows="4" maxlength="500" required
                    class="w-full p-4 rounded-2xl border border-slate-200 bg-slate-50 text-sm font-medium text-slate-800 focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition leading-relaxed"
                    placeholder="Conduite très sécurisante, courtoisie irréprochable...">Conducteur très ponctuel à la Gare Al Massira. Conduite agréable et particulièrement sécurisante sur l'autoroute de Marrakech. Je recommande vivement Karim pour vos trajets interurbains !</textarea>

                <div class="flex items-center justify-between text-[11px] text-slate-400 pt-1">
                    <span class="text-emerald-700 font-semibold">✓ Avis détaillé et utile</span>
                    <span id="char-counter">179 / 500 caractères</span>
                </div>
            </div>

            <!-- Transparence Box -->
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-500 flex items-start gap-2.5">
                <span class="text-slate-400">🛡</span>
                <span class="leading-relaxed">
                    <strong>Transparence SafarCar :</strong> Les retours d'expérience sont 100% authentifiés et exclusivement réservés aux passagers confirmés ayant validé leur billet via la plateforme.
                </span>
            </div>

            <!-- Submit CTA -->
            <button type="submit"
                class="w-full py-4 px-6 rounded-2xl bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-base shadow-md shadow-emerald-700/20 hover:scale-[1.01] active:scale-[0.99] transition flex items-center justify-center gap-2">
                <span>Publier mon avis vérifié</span>
                <span>▷</span>
            </button>

            <div class="text-center">
                <a href="{{ path('app_passenger_bookings') }}" class="text-xs font-semibold text-slate-400 hover:text-slate-600 transition">
                    Plus tard / Passer cette étape
                </a>
            </div>

        </form>

        <p class="text-center text-[10px] text-slate-400 pt-2 border-t border-slate-100">
            🔒 Transmission chiffrée SSL · Normes de modération transport CNDP Maroc
        </p>

    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const stars = document.querySelectorAll('.star-btn');
    const ratingInput = document.getElementById('review-rating');
    const ratingLabel = document.getElementById('rating-label');
    const commentInput = document.getElementById('review-comment');
    const charCounter = document.getElementById('char-counter');

    const labels = {
        1: 'Médiocre (1 sur 5)',
        2: 'Moyen (2 sur 5)',
        3: 'Bien (3 sur 5)',
        4: 'Très bien (4 sur 5)',
        5: 'Exceptionnel (5 sur 5)'
    };

    function updateStars(val) {
        stars.forEach((s, idx) => {
            if (idx < val) {
                s.className = 'star-btn text-3xl sm:text-4xl text-amber-400 hover:scale-110 transition cursor-pointer';
            } else {
                s.className = 'star-btn text-3xl sm:text-4xl text-slate-200 hover:scale-110 transition cursor-pointer';
            }
        });
        ratingInput.value = val;
        ratingLabel.textContent = labels[val] || `${val} sur 5`;
    }

    stars.forEach(s => {
        s.addEventListener('click', function() {
            updateStars(parseInt(this.dataset.rating, 10));
        });
    });

    updateStars(4);

    // Character counter
    commentInput.addEventListener('input', function() {
        charCounter.textContent = `${this.value.length} / 500 caractères`;
    });

    // Toggle pill tags
    document.querySelectorAll('.pill-tag').forEach(tag => {
        tag.addEventListener('click', function() {
            if (this.textContent.includes('✓')) {
                this.className = 'pill-tag px-3 py-1.5 rounded-xl border text-xs font-medium border-slate-200 text-slate-600 hover:bg-slate-100 transition';
                this.textContent = '+ ' + this.textContent.replace('✓ ', '').trim();
            } else {
                this.className = 'pill-tag px-3 py-1.5 rounded-xl border text-xs font-bold bg-emerald-50 border-emerald-500 text-emerald-800 transition';
                this.textContent = '✓ ' + this.textContent.replace('+ ', '').trim();
            }
        });
    });
});
</script>
{% endblock %}

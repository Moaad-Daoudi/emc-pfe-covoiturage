<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50 text-slate-900">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}SafarCar — Covoiturage Régional{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🚗</text></svg>">
        
        <!-- Tailwind CSS -->
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: {
                                50: '#eff6ff',
                                500: '#0284c7',
                                600: '#0369a1',
                                700: '#075985',
                            }
                        }
                    }
                }
            }
        </script>

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-full flex flex-col font-sans antialiased">
        <!-- Navigation Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                <a href="{{ path('app_home') }}" class="flex items-center gap-2 font-bold text-xl text-brand-600">
                    <span class="text-2xl">🚗</span>
                    <span>SafarCar</span>
                    <span class="text-xs bg-brand-50 text-brand-700 px-2 py-0.5 rounded-full border border-brand-200 font-medium">EMC 2026</span>
                </a>

                <nav class="flex items-center gap-4 text-sm font-medium">
                    <a href="{{ path('app_home') }}" class="text-slate-700 hover:text-brand-600 transition">Rechercher</a>
                    <a href="#publish" class="text-slate-700 hover:text-brand-600 transition">Publier un trajet</a>
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('admin') }}" class="bg-slate-800 hover:bg-slate-900 text-white px-3 py-1.5 rounded-lg text-xs font-semibold shadow-sm transition">⚙️ Back-Office</a>
                        {% endif %}
                        <span class="text-slate-600 text-xs font-medium">{{ app.user.firstname }}</span>
                        <a href="{{ path('app_logout') }}" class="text-rose-600 hover:text-rose-700 text-xs transition">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-lg font-medium shadow-sm transition">Connexion</a>
                    {% endif %}
                </nav>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1">
            {% block body %}{% endblock %}
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-500">
            <div class="max-w-7xl mx-auto px-4">
                <p>SafarCar — Plateforme de Covoiturage Régional (Sujet 3) • PFE Challenge EMC</p>
                <p class="mt-1">Symfony 7.4 • PHP 8.3 • MySQL 8.0 • Docker</p>
            </div>
        </footer>
    </body>
</html>
